{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/src", "<rootDir>/test"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/mapped-types|@nestjs/jwt)/)"
  ],
  "moduleNameMapper": {
    "^\\./internal/(.*)$": "<rootDir>/node_modules/@prisma/client/runtime/$1"
  },
  "testEnvironment": "node"
}
